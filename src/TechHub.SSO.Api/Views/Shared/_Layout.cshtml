<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Autenticación centralizada del stack TechHub" />
    <title>@(ViewData["Title"] ?? "TechHub SSO")</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='11' fill='%2338bdf8'/%3E%3Ctext x='12' y='17' font-size='14' text-anchor='middle' fill='%23082f49' font-family='sans-serif' font-weight='bold'%3ET%3C/text%3E%3C/svg%3E" />
    <style>
        :root {
            color-scheme: dark;
            --bg: #0f172a; --surface: #1e293b; --border: #334155;
            --text: #e2e8f0; --muted: #94a3b8; --subtle: #cbd5e1;
            --accent: #38bdf8; --accent-hover: #7dd3fc; --on-accent: #082f49;
            --danger-bg: #7f1d1d; --danger-text: #fecaca; --field-error: #fca5a5;
        }
        * { box-sizing: border-box; }
        html { height: 100%; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: radial-gradient(1200px 600px at 50% -10%, #1e3a5f 0%, var(--bg) 55%);
            color: var(--text); padding: 1rem;
        }
        .shell { width: 100%; max-width: 420px; }
        .brand { display: flex; align-items: center; gap: .6rem; justify-content: center; margin-bottom: 1.25rem; }
        .brand svg { width: 34px; height: 34px; }
        .brand span { font-size: 1.05rem; font-weight: 700; letter-spacing: .04em; }
        .card {
            width: 100%; padding: 2.25rem 2.5rem;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 14px; box-shadow: 0 10px 40px rgba(0,0,0,.45);
        }
        h1 { font-size: 1.35rem; margin: 0 0 .25rem; }
        p.sub { margin: 0 0 1.5rem; color: var(--muted); font-size: .9rem; line-height: 1.45; }
        label { display: block; margin-bottom: .35rem; font-size: .85rem; color: var(--subtle); }
        input[type=email], input[type=password], input[type=text] {
            width: 100%; padding: .6rem .75rem; margin-bottom: 1rem; border-radius: 8px;
            border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: .95rem;
        }
        input::placeholder { color: #64748b; }
        input:focus { outline: 2px solid var(--accent); border-color: transparent; }
        input:invalid:not(:placeholder-shown):not(:focus) { border-color: #b91c1c; }
        button {
            width: 100%; padding: .65rem; border: 0; border-radius: 8px; cursor: pointer;
            background: var(--accent); color: var(--on-accent); font-weight: 600; font-size: .95rem;
            transition: background .15s ease;
        }
        button:hover { background: var(--accent-hover); }
        button:focus-visible { outline: 2px solid var(--accent-hover); outline-offset: 2px; }
        .error { background: var(--danger-bg); color: var(--danger-text); padding: .6rem .8rem; border-radius: 8px; font-size: .85rem; margin-bottom: 1rem; }
        .field-error { display: block; min-height: 1rem; margin: -0.75rem 0 .75rem; color: var(--field-error); font-size: .78rem; }
        .row { display: flex; gap: .75rem; }
        .row > div { flex: 1; }
        .hint { font-size: .75rem; color: var(--muted); margin: -.75rem 0 .75rem; }
        .switch { margin-top: 1.25rem; text-align: center; font-size: .85rem; color: var(--muted); }
        .switch a { color: var(--accent); }
        .switch a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        footer { margin-top: 1.5rem; text-align: center; font-size: .75rem; color: #64748b; }
        @@media (prefers-reduced-motion: reduce) { button { transition: none; } }
        @@media (max-width: 420px) { .card { padding: 1.75rem 1.25rem; } .row { flex-direction: column; gap: 0; } }
    </style>
</head>
<body>
    <main class="shell">
        <div class="brand" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#38bdf8"/><text x="12" y="17" font-size="14" text-anchor="middle" fill="#082f49" font-family="sans-serif" font-weight="bold">T</text></svg>
            <span>TechHub&nbsp;SSO</span>
        </div>
        <div class="card">
            @RenderBody()
        </div>
        <footer>Servidor de autorización centralizado &middot; sus credenciales nunca salen de este dominio</footer>
    </main>
</body>
</html>
