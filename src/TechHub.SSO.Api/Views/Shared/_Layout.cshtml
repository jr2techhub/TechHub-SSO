<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TechHub SSO - Inicio de sesión</title>
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: #0f172a; color: #e2e8f0;
        }
        .card {
            width: 100%; max-width: 400px; padding: 2.5rem;
            background: #1e293b; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,.4);
        }
        h1 { font-size: 1.4rem; margin: 0 0 .25rem; }
        p.sub { margin: 0 0 1.5rem; color: #94a3b8; font-size: .9rem; }
        label { display: block; margin-bottom: .35rem; font-size: .85rem; color: #cbd5e1; }
        input[type=email], input[type=password], input[type=text] {
            width: 100%; padding: .6rem .75rem; margin-bottom: 1rem; border-radius: 8px;
            border: 1px solid #334155; background: #0f172a; color: #e2e8f0; font-size: .95rem;
        }
        input:focus { outline: 2px solid #38bdf8; border-color: transparent; }
        button {
            width: 100%; padding: .65rem; border: 0; border-radius: 8px; cursor: pointer;
            background: #38bdf8; color: #082f49; font-weight: 600; font-size: .95rem;
        }
        button:hover { background: #7dd3fc; }
        .error { background: #7f1d1d; color: #fecaca; padding: .6rem .8rem; border-radius: 8px; font-size: .85rem; margin-bottom: 1rem; }
        .field-error { display: block; min-height: 1rem; margin: -0.75rem 0 .75rem; color: #fca5a5; font-size: .78rem; }
        .row { display: flex; gap: .75rem; }
        .row > div { flex: 1; }
        .switch { margin-top: 1.25rem; text-align: center; font-size: .85rem; color: #94a3b8; }
        .switch a { color: #38bdf8; }
        footer { margin-top: 1.5rem; text-align: center; font-size: .75rem; color: #64748b; }
    </style>
</head>
<body>
    <div class="card">
        @RenderBody()
        <footer>TechHub SSO &middot; Servidor de autorización centralizado</footer>
    </div>
</body>
</html>
